DOMAIN=10.110.161.242

# --------------------- POSTGRES ---------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dbname
POSTGRES_HOST=postgres          # nombre del servicio en la red de Docker
POSTGRES_PORT=5432              # puerto interno del contenedor
POSTGRES_HOST_PORT=5432         # puerto expuesto en el host (puedes cambiarlo)

# --------------------- PGADMIN ----------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050               # puerto en el host

# --------------------- BACKEND ----------------------
BACKEND_PORT=8000               # puerto en el host

# Cadena de conexión completa (construida a partir de las variables anteriores)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Celery (asumiendo que tienes RabbitMQ y Redis corriendo)
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# URL pública para el frontend (apunta al backend)
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}

# --------------------- FRONTEND ---------------------
FRONTEND_PORT=3000              # puerto en el host